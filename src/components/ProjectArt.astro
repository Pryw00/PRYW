---
/**
 * Generative artwork for projects without imagery.
 * Drawn in `currentColor`, so it inherits the tile's ink colour.
 */
interface Props {
  variant: 'pixel' | 'bars' | 'shield' | 'waves' | 'dots';
  seed?: string;
  class?: string;
}

const { variant, seed = variant, class: className } = Astro.props;

// Deterministic PRNG so the build output is stable
let s = [...seed].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32);

// pixel: retro-gaming invader sprite (11 × 8)
const sprite = [
  '00100000100',
  '00010001000',
  '00111111100',
  '01101110110',
  '11111111111',
  '10111111101',
  '10100000101',
  '00011011000',
];
const pixels = sprite.flatMap((row, y) =>
  [...row].map((v, x) => (v === '1' ? { x, y, d: (x + y) * 0.06 } : null)).filter(Boolean),
) as { x: number; y: number; d: number }[];
const stars = Array.from({ length: 26 }, () => ({ x: rand() * 400, y: rand() * 400, d: rand() * 3 }));

// bars: two candidates compared across axes
const bars = Array.from({ length: 7 }, (_, i) => ({ i, a: 0.3 + rand() * 0.7, b: 0.3 + rand() * 0.7 }));

// waves: topographic contour lines
const waves = Array.from({ length: 11 }, (_, i) => {
  const y = 60 + i * 28;
  const amp = 10 + rand() * 22;
  const ph = rand() * 200;
  return `M -20 ${y} C ${80 + ph / 4} ${y - amp}, ${160 - ph / 5} ${y + amp}, 220 ${y} S ${360 + ph / 6} ${y - amp}, 440 ${y}`;
});

// dots: map grid with a few "available" pins
const dots = [] as { x: number; y: number; r: number; pin: boolean; d: number }[];
for (let y = 0; y < 14; y++) {
  for (let x = 0; x < 14; x++) {
    const cx = 30 + x * 26.5;
    const cy = 30 + y * 26.5;
    const inside = Math.hypot(cx - 200 + Math.sin(y) * 20, cy - 210) < 170 - rand() * 30;
    if (inside) dots.push({ x: cx, y: cy, r: 2.6, pin: rand() > 0.94, d: rand() * 2 });
  }
}
---
<!-- `art` is the hook that pauses these loops off-screen (styles/global.css) -->
<svg class:list={['art size-full overflow-visible', className]} viewBox="0 0 400 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  {variant === 'pixel' && (
    <g>
      {stars.map((st) => <rect class="animate-blink" x={st.x} y={st.y} width="3" height="3" fill="currentColor" style={`animation-delay:${st.d}s`} />)}
      <g class="animate-float" transform="translate(79 110)">
        {pixels.map((p) => (
          <rect class="origin-center animate-pop [transform-box:fill-box]" x={p.x * 22} y={p.y * 22} width="21" height="21" fill="currentColor" style={`animation-delay:${p.d}s`} />
        ))}
      </g>
      <rect x="0" y="330" width="400" height="4" fill="currentColor" opacity="0.4" />
      <rect class="animate-scan" x="0" y="0" width="400" height="6" fill="currentColor" opacity="0.18" />
    </g>
  )}

  {variant === 'bars' && (
    <g>
      {bars.map((b) => (
        <g transform={`translate(${40 + b.i * 48} 340)`}>
          <rect class="origin-bottom animate-grow [transform-box:fill-box]" x="0" y={-b.a * 260} width="18" height={b.a * 260} fill="currentColor" style={`animation-delay:${b.i * 0.08}s`} />
          <rect class="origin-bottom animate-grow [transform-box:fill-box]" x="21" y={-b.b * 260} width="18" height={b.b * 260} stroke="currentColor" stroke-width="2" style={`animation-delay:${b.i * 0.08 + 0.04}s`} />
        </g>
      ))}
      <line x1="30" y1="342" x2="370" y2="342" stroke="currentColor" stroke-width="2" />
    </g>
  )}

  {variant === 'shield' && (
    <g>
      <g opacity="0.25" stroke="currentColor" stroke-width="1">
        {Array.from({ length: 11 }, (_, i) => <line x1={i * 40} y1="0" x2={i * 40} y2="400" />)}
        {Array.from({ length: 11 }, (_, i) => <line x1="0" y1={i * 40} x2="400" y2={i * 40} />)}
      </g>
      {[1, 0.78, 0.56, 0.34].map((k, i) => (
        <path
          class="animate-shield"
          style={`animation-delay:${i * 0.35}s; transform-origin: 200px 200px; transform: scale(${k})`}
          d="M200 40 L330 90 C330 210 290 300 200 360 C110 300 70 210 70 90 Z"
          stroke="currentColor"
          stroke-width={3 / k}
          fill={i === 3 ? 'currentColor' : 'none'}
        />
      ))}
      <circle class="origin-[200px_200px] animate-orbit" cx="200" cy="200" r="175" stroke="currentColor" stroke-width="2" stroke-dasharray="4 14" />
    </g>
  )}

  {variant === 'waves' && (
    <g>
      {waves.map((d, i) => (
        <path class="animate-draw [stroke-dasharray:1] [stroke-dashoffset:1]" d={d} stroke="currentColor" stroke-width={i % 3 === 0 ? 3 : 1.5} pathLength="1" style={`animation-delay:${i * 0.12}s`} />
      ))}
      <g class="animate-float" transform="translate(250 150)">
        <circle r="16" fill="currentColor" />
        <circle class="origin-center animate-ring [transform-box:fill-box]" r="16" stroke="currentColor" stroke-width="2" />
      </g>
    </g>
  )}

  {variant === 'dots' && (
    <g>
      {dots.map((d) =>
        d.pin ? (
          <g transform={`translate(${d.x} ${d.y})`}>
            <circle r="7" fill="currentColor" />
            <circle class="origin-center animate-ring [transform-box:fill-box]" r="7" stroke="currentColor" stroke-width="2" style={`animation-delay:${d.d}s`} />
          </g>
        ) : (
          <circle class="animate-blink-soft opacity-55" cx={d.x} cy={d.y} r={d.r} fill="currentColor" style={`animation-delay:${d.d}s`} />
        ),
      )}
    </g>
  )}
</svg>

