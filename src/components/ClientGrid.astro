---
import ClientTile from './ClientTile.astro';
import { colorFor } from '../data/palette';
import type { GalleryInput } from '../data/gallery';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Client {
  name: string;
  url: string;
  category: string;
  thumbnail?: string;
  color?: string;
  status?: 'live' | 'archived';
  gallery?: GalleryInput[];
}

interface Props {
  clients: Client[];
  filters?: boolean;
}

const { clients, filters = true } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const catLabel = (cat: string) => t(`cat.${cat}` as 'cat.Gobierno');

const categories = [
  'Arte y Galerías',
  'Personal / Político',
  'Gobierno',
  'Restaurantes y Pequeños Negocios',
].filter((cat) => clients.some((c) => c.category === cat));
const archivedCount = clients.filter((c) => c.status === 'archived').length;
---
{filters && (
  <div
    class="chips rail pb-(--space-md) sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0"
    data-filters="clients"
    data-filter-key="category"
    role="group"
    aria-label={t('clients.filter')}
  >
    <button class="chip" data-filter="*" aria-pressed="true">{t('clients.all')} · {clients.length}</button>
    {categories.map((cat) => (
      <button class="chip" data-filter={cat} aria-pressed="false">
        {catLabel(cat)} · {clients.filter((c) => c.category === cat).length}
      </button>
    ))}
    {archivedCount > 0 && (
      <button class="chip" data-filter="archived" data-filter-key="status" aria-pressed="false">
        {t('status.filter')} · {archivedCount}
      </button>
    )}
  </div>
)}

<!-- The home preview caps at 3 columns so 6 sites fill two full rows -->
<div
  class:list={[
    'grid grid-cols-1 gap-x-(--tile-gap) gap-y-(--space-md) sm:grid-cols-2 lg:grid-cols-3',
    { '2xl:grid-cols-4': filters },
  ]}
  data-filter-scope="clients"
>
  {clients.map((client, i) => (
    <ClientTile {...client} color={client.color ?? colorFor(i)} />
  ))}
</div>
