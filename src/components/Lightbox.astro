---
// Image gallery viewer. Any element with
//   data-lightbox='[{"src":"/images/…","caption":"…"}, …]'  (see data/gallery.ts → lightboxData)
// and an optional data-lightbox-index opens it at that image.
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));
const navBtn =
  'js-lb-nav absolute top-1/2 z-1 grid size-12 -translate-y-1/2 place-items-center rounded-full border border-line bg-bg/70 text-xl backdrop-blur-sm transition-colors duration-180 ease-out hover:border-fg hover:bg-fg hover:text-bg disabled:pointer-events-none disabled:opacity-0 sm:size-14';
---
<dialog
  id="lightbox"
  class="m-0 h-dvh max-h-none w-screen max-w-none flex-col bg-transparent p-0 text-fg backdrop:bg-bg/90 backdrop:backdrop-blur-sm open:flex"
  aria-label={t('lightbox.label')}
>
  <div class="wrap flex min-h-(--header-h) items-center justify-between gap-4 py-2">
    <p class="mono min-w-0 truncate text-soft">
      <span class="js-lb-counter text-fg"></span>
      <span class="js-lb-caption"></span>
    </p>
    <button class="js-lb-close mono min-h-11 shrink-0 rounded-full border border-line px-4 transition-colors duration-180 ease-out hover:border-fg hover:bg-fg hover:text-bg" type="button" autofocus>
      {t('lightbox.close')} ✕
    </button>
  </div>

  <div class="js-lb-stage relative flex min-h-0 flex-1 touch-pan-y items-center justify-center px-(--gutter) pb-(--gutter) select-none">
    <button class:list={[navBtn, 'left-(--gutter)']} data-dir="-1" type="button" aria-label={t('lightbox.prev')}>←</button>
    <img class="js-lb-img max-h-full max-w-full bg-surface object-contain" alt="" draggable="false" />
    <button class:list={[navBtn, 'right-(--gutter)']} data-dir="1" type="button" aria-label={t('lightbox.next')}>→</button>
  </div>
</dialog>

<script>
  import { setScrollLocked } from '../scripts/motion';

  type Item = { src: string; caption?: string };
  let items: Item[] = [];
  let index = 0;

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(`#lightbox ${sel}`)!;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const item = items[index];
    const img = $<HTMLImageElement>('.js-lb-img');
    img.src = item.src;
    img.alt = item.caption ?? '';
    $('.js-lb-caption').textContent = item.caption ?? '';
    $('.js-lb-counter').textContent = items.length > 1 ? `${index + 1} / ${items.length} · ` : '';
    document.querySelectorAll<HTMLButtonElement>('#lightbox .js-lb-nav').forEach((b) => (b.disabled = items.length < 2));
    // Warm up the neighbours so arrows feel instant
    [index + 1, index - 1].forEach((n) => { new Image().src = items[(n + items.length) % items.length].src; });
  }

  function open(list: Item[], start: number) {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dialog || !list.length) return;
    items = list;
    show(start);
    dialog.addEventListener('close', () => setScrollLocked(false), { once: true });
    setScrollLocked(true);
    dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

    if (dialog?.open) {
      const nav = target.closest<HTMLElement>('.js-lb-nav');
      if (nav) return show(index + Number(nav.dataset.dir));
      // Close button, or a click on empty space around the image
      if (target.closest('.js-lb-close') || target === dialog || target.classList.contains('js-lb-stage')) dialog.close();
      return;
    }

    const trigger = target.closest<HTMLElement>('[data-lightbox]');
    if (!trigger) return;
    e.preventDefault();
    open(JSON.parse(trigger.dataset.lightbox!), Number(trigger.dataset.lightboxIndex ?? 0));
  });

  document.addEventListener('keydown', (e) => {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dialog?.open || items.length < 2) return;
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === 'ArrowLeft') show(index - 1);
  });

  // Swipe on touch screens
  let startX: number | null = null;
  document.addEventListener('pointerdown', (e) => {
    if ((e.target as Element).closest?.('#lightbox .js-lb-stage')) startX = e.clientX;
  });
  document.addEventListener('pointerup', (e) => {
    if (startX === null) return;
    const dx = e.clientX - startX;
    startX = null;
    if (Math.abs(dx) > 50 && items.length > 1) show(index + (dx < 0 ? 1 : -1));
  });
</script>
