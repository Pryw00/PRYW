---
interface Props {
  skills: readonly string[];
}

const { skills } = Astro.props;
const half = Math.ceil(skills.length / 2);
const rows = [
  { items: skills.slice(0, half), dir: "forward", speed: 28 },
  { items: skills.slice(half), dir: "reverse", speed: 34 },
];
---

<div class="flex flex-col gap-1 overflow-hidden">
  <p class="sr-only">Tecnologías: {skills.join(", ")}</p>
  {
    rows.map((row, r) => (
      <div class="overflow-hidden" aria-hidden="true">
        <div
          class="marquee-track flex w-max"
          data-marquee={row.dir}
          data-speed={row.speed}
        >
          {[0, 1].map(() => (
            <div class="flex shrink-0">
              {[...row.items, ...row.items].map((skill, i) => (
                <span
                  class:list={[
                    "inline-flex items-center font-display text-[clamp(2.25rem,6vw,3rem)] leading-[1.05] font-medium tracking-[-0.02em] whitespace-nowrap uppercase [font-stretch:125%]",
                    { "text-transparent [-webkit-text-stroke:1.5px_var(--color-fg)]": (i + r) % 2 === 1 },
                  ]}
                >
                  {skill}
                  <span class="mx-[0.35em] text-[0.4em] text-accent [-webkit-text-stroke:0]">✦</span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
