---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { toGallery, lightboxData, type GalleryInput } from '../data/gallery';

interface Props {
  name: string;
  url: string;
  category: string;
  thumbnail?: string;
  color: string;
  status?: 'live' | 'archived';
  gallery?: GalleryInput[];
}

const { name, url, category, thumbnail, color, status = 'live', gallery: photos = [] } = Astro.props;
const archived = status === 'archived';
const t = useTranslations(getLangFromUrl(Astro.url));
const domain = url.replace(/^https?:\/\//, '').replace(/\/$/, '');

// Live → visit the site. Archived → open screenshot + photo gallery (if any), otherwise not clickable.
const gallery = [
  ...(thumbnail ? [{ src: thumbnail, caption: `${name} — ${t('clients.shotCaption')}` }] : []),
  ...toGallery(photos, name),
];
const hasGallery = archived && gallery.length > 0;
const Tag = !archived ? 'a' : hasGallery ? 'button' : 'div';
const linkProps = !archived
  ? { href: url, target: '_blank', rel: 'noopener noreferrer', 'data-cursor': t('cursor.visit') }
  : hasGallery
    ? { type: 'button', 'data-lightbox': lightboxData(gallery), 'data-cursor': t(photos.length ? 'cursor.gallery' : 'cursor.shot') }
    : {};
---
<Tag
  {...linkProps}
  class:list={[
    'client reveal group/client flex flex-col gap-3 text-left',
    { 'is-archived': archived, 'cursor-default': archived && !hasGallery },
  ]}
  data-color={color}
  data-category={category}
  data-status={status}
>
  <div class="relative aspect-16/10 overflow-hidden bg-surface">
    {thumbnail ? (
      <img
        src={thumbnail}
        alt={`${t('clients.shotAlt')} ${name}`}
        width="960"
        height="600"
        loading="lazy"
        decoding="async"
        class:list={[
          'size-full object-cover object-top [transition:scale_1s_var(--ease-out),filter_0.6s] group-hover/client:scale-106 group-hover/client:[filter:none]',
          archived ? '[filter:grayscale(1)_brightness(0.7)]' : '[filter:grayscale(0.35)]',
        ]}
      />
    ) : (
      <div
        class:list={['heading-display grid size-full place-items-center bg-c p-4 text-center text-[clamp(1.75rem,4vw,3rem)] text-ink', { 'saturate-[0.2]': archived }]}
        aria-hidden="true"
      >
        {name}
      </div>
    )}
    {archived && (
      <span class="mono absolute top-3 left-3 z-1 border border-line bg-bg px-[0.6rem] py-[0.3rem] text-fg">{t('status.archived')}</span>
    )}
    <div
      class="absolute inset-0 flex items-end bg-c p-4 text-ink [clip-path:inset(100%_0_0_0)] [transition:clip-path_0.6s_var(--ease-out)] group-hover/client:[clip-path:inset(55%_0_0_0)]"
      aria-hidden="true"
    >
      <span class="heading-display text-[clamp(1.5rem,3vw,2.5rem)]">{name}</span>
    </div>
  </div>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="font-medium">{name}</span>
    <span class:list={['font-mono text-mono tracking-[0.04em] text-soft group-hover/client:text-c', { 'line-through': archived && !hasGallery }]}>
      {!archived ? `${domain} ↗` : !hasGallery ? domain : photos.length ? `${t('status.viewGallery')} · ${gallery.length}` : t('status.viewShot')}
    </span>
  </div>
</Tag>
