---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

interface Props {
  name: string;
  tagline: string;
  location: string;
}

const { name, tagline, location } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const [first, ...rest] = name.split(" ");
const tagColors = ["lime", "pink", "yellow", "cyan"];
const disciplines = t("hero.tags").map((label, i) => ({
  label,
  color: tagColors[i],
}));
---

<section
  class="hero relative flex min-h-svh items-stretch overflow-hidden pt-(--header-h)"
  data-hero
  aria-labelledby="hero-title"
>
  <!-- Morphing colour blob -->
  <div
    class="hero-blob pointer-events-none absolute top-[18%] -right-[10%] aspect-square w-[min(70vw,760px)] max-sm:top-[30%] max-sm:-right-[40%] max-sm:w-[110vw]"
    aria-hidden="true"
  >
    <div
      class="size-full animate-morph rounded-[42%_58%_63%_37%/41%_44%_56%_59%] opacity-55 [background:conic-gradient(from_90deg,var(--color-block-purple),var(--color-block-blue),var(--color-block-cyan),var(--color-block-lime),var(--color-block-pink),var(--color-block-purple))] [filter:blur(60px)_saturate(1.2)]"
    >
    </div>
  </div>

  <div
    class="wrap relative z-1 flex flex-col justify-between gap-(--space-md) pt-(--space-md) pb-(--space-lg)"
  >
    <div class="flex flex-wrap items-center justify-between gap-(--space-sm)">
      <p class="eyebrow">{t("hero.eyebrow")} · {location}</p>
      <ul class="flex flex-wrap gap-[0.4rem]" role="list">
        {
          disciplines.map((d) => (
            <li
              class="mono rounded-full bg-c px-[0.7rem] py-[0.35rem] text-ink"
              data-color={d.color}
            >
              {d.label}
            </li>
          ))
        }
      </ul>
    </div>

    <h1
      id="hero-title"
      class="font-art text-giant leading-[0.82] font-normal tracking-[-0.02em] max-sm:text-[22vw]"
    >
      <span class="block" data-split>{first}</span>
      <span class="block pl-[0.6em] max-sm:pl-[0.3em] lg:pl-[1.4em]" data-split
        >{rest.join(" ")}</span
      >
    </h1>

    <div class="flex flex-wrap items-end justify-between gap-(--space-md)">
      <p
        class="min-h-[1.5em] font-mono text-[clamp(0.8rem,1.4vw,1rem)] tracking-[0.04em] text-fg"
      >
        <span class="mr-[0.5em] text-accent">&gt;</span>
        <span data-typewriter>{tagline.toLowerCase()} — {t("hero.suffix")}</span
        ><span
          class="ml-[2px] inline-block h-[1.1em] w-[0.6em] animate-caret bg-accent align-text-bottom"
          aria-hidden="true"></span>
      </p>
      <div class="flex flex-wrap gap-[0.6rem] max-sm:w-full">
        <a
          href="#trabajo"
          class="btn btn-solid max-sm:flex-1 max-sm:justify-center"
          data-magnetic>{t("hero.cta")}</a
        >
        <a
          href="mailto:pryw95@gmail.com"
          class="btn max-sm:flex-1 max-sm:justify-center"
          data-magnetic>{t("hero.talk")}</a
        >
      </div>
    </div>
  </div>

  <div
    class="mono absolute right-(--gutter) bottom-(--space-lg) z-1 hidden flex-col items-center gap-3 text-soft [writing-mode:vertical-rl] lg:flex"
    aria-hidden="true"
  >
    <span>Scroll</span>
    <span
      class="h-16 w-px animate-scroll-line [background-image:linear-gradient(var(--color-fg)_50%,transparent_50%)] [background-size:1px_200%]"
    ></span>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  // Blob drifts towards the pointer
  document.addEventListener("astro:page-load", () => {
    const blob = document.querySelector<HTMLElement>(".hero-blob");
    if (
      !blob ||
      !matchMedia("(pointer: fine)").matches ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    const xTo = gsap.quickTo(blob, "x", { duration: 2, ease: "power3.out" });
    const yTo = gsap.quickTo(blob, "y", { duration: 2, ease: "power3.out" });
    const hero = blob.closest<HTMLElement>(".hero")!;
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      xTo((e.clientX / r.width - 0.5) * 160);
      yTo((e.clientY / r.height - 0.5) * 120);
    });
  });
</script>
