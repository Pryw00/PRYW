---
import { getProfile } from "../data/profile";
import { getLangFromUrl, useTranslations, path } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);

const socials = [
  { label: "GitHub", href: profile.contact.github },
  { label: "LinkedIn", href: profile.contact.linkedin },
  {
    label: "WhatsApp",
    href: `https://wa.me/${profile.contact.phone.replace(/\D/g, "")}`,
  },
];

const linkClass = "inline-flex min-h-11 items-center gap-3 text-[1.05rem] transition-colors duration-180 ease-out hover:text-accent";
---

<footer class="relative overflow-hidden border-t border-line bg-bg pt-(--space-xl)" id="contacto">
  <div class="wrap">
    <p class="eyebrow">{t("footer.eyebrow")}</p>

    <a
      href={`mailto:${profile.contact.email}`}
      class="group/cta mt-(--space-sm) mb-(--space-lg) flex items-start gap-[0.1em] font-art text-giant leading-[0.85] font-normal tracking-[-0.02em] [transition:color_450ms_var(--ease-out)] hover:text-accent"
      data-cursor={t("cursor.write")}
    >
      <span data-split="words">{t("footer.cta")}</span>
      <span class="text-[0.45em] leading-none [transition:transform_0.6s_var(--ease-out)] group-hover/cta:[transform:translate(0.15em,-0.15em)_rotate(45deg)]" aria-hidden="true">↗</span>
    </a>

    <div class="grid grid-cols-1 gap-(--space-md) border-t border-line py-(--space-md) md:grid-cols-[2fr_1fr_1fr]">
      <div class="flex flex-col items-start gap-1">
        <span class="mono mb-2 text-soft">{t("footer.email")}</span>
        <button
          class="js-copy inline-flex min-h-11 items-center gap-3 text-left text-[clamp(1.1rem,2.4vw,1.6rem)] break-all transition-colors duration-180 ease-out hover:text-accent"
          data-copy={profile.contact.email}
          data-copied={t("footer.copied")}
          data-label={t("footer.copy")}
        >
          <span>{profile.contact.email}</span>
          <span class="copy-hint mono rounded-full border border-line px-2 py-[0.2rem] break-normal text-soft" aria-hidden="true">{t("footer.copy")}</span>
        </button>
        <a href={`tel:${profile.contact.phone.replace(/\s/g, "")}`} class={linkClass}>{profile.contact.phone}</a>
      </div>

      <div class="flex flex-col items-start gap-1">
        <span class="mono mb-2 text-soft">{t("footer.social")}</span>
        {
          socials.map((s) => (
            <a href={s.href} class={linkClass} target="_blank" rel="noopener noreferrer">
              {s.label} ↗
            </a>
          ))
        }
      </div>

      <nav class="flex flex-col items-start gap-1" aria-label={t("nav.footer")}>
        <span class="mono mb-2 text-soft">{t("footer.map")}</span>
        <a href={path("home", lang)} class={linkClass}>{t("nav.home")}</a>
        <a href={path("projects", lang)} class={linkClass}>{t("nav.projects")}</a>
        <a href={path("clients", lang)} class={linkClass}>{t("nav.clients")}</a>
        <a href={path("about", lang)} class={linkClass}>{t("nav.about")}</a>
      </nav>
    </div>

    <div class="mono flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-line py-(--space-md) text-soft">
      <span>© {new Date().getFullYear()} {profile.name} / {profile.handle}</span>
      <span>{t("footer.made")} · {profile.location}</span>
    </div>
  </div>

  <div class="-mb-[0.12em] text-center font-art text-[34vw] leading-[0.75] font-normal tracking-[-0.07em] text-transparent select-none [-webkit-text-stroke:1px_var(--color-line)]" aria-hidden="true">PRYW</div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>(".js-copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const label = btn.querySelector(".copy-hint");
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          if (label) label.textContent = btn.dataset.copied ?? "";
        } catch {
          window.location.href = `mailto:${btn.dataset.copy}`;
        }
        setTimeout(() => {
          if (label) label.textContent = btn.dataset.label ?? "";
        }, 1800);
      });
    });
  });
</script>

