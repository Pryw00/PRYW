---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { getProfile } from '../data/profile';
import { colorFor } from '../data/palette';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import Portrait from '../components/Portrait.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const rowClass = 'grid grid-cols-1 gap-x-4 py-[0.35rem] md:grid-cols-[11rem_1fr]';
---
<BaseLayout
  title={`${t('nav.about')} — Wilson Yépez @Pryw00`}
  description={`${profile.title}. ${profile.bio}`}
>
  <!-- Intro -->
  <section class="wrap pt-[calc(var(--header-h)+var(--space-lg))] pb-(--space-xl)" data-hero aria-labelledby="about-heading">
    <p class="eyebrow">{t('about.eyebrow')} · {profile.handle}</p>
    <h1 id="about-heading" class="mt-(--space-xs) mb-(--space-lg) font-art text-(length:--text-hero) leading-[0.85] font-normal tracking-[-0.01em]">
      <span class="split-line" data-split>{t('about.line1')}</span>
      <span class="split-line text-outline" data-split>{t('about.line2')}</span>
    </h1>

    <div class="grid grid-cols-1 gap-(--space-lg) md:grid-cols-[1fr_1.6fr] md:items-start">
      <div class="reveal max-w-[420px]"><Portrait eager /></div>

      <div>
        <p class="font-display text-[clamp(1.4rem,2.8vw,2.4rem)] leading-[1.12] font-medium tracking-[-0.02em]" data-scrub-words>{profile.bio}</p>
        <ul class="mt-(--space-md) flex flex-col gap-2 text-soft" role="list">
          {profile.title.split(' · ').map((t) => <li class="mono reveal">✦ {t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="wrap pt-(--space-xl)" aria-labelledby="exp-heading">
    <div class="section-head">
      <h2 id="exp-heading" class="section-title heading-art" data-split="words">{t('about.experience')}</h2>
    </div>
    <ol class="border-b border-line" role="list">
      {profile.experience.map((item, i) => (
        <li
          class="reveal group/exp relative isolate grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 overflow-hidden border-t border-line px-2 py-(--space-sm) [transition:color_0.4s] before:absolute before:inset-0 before:-z-1 before:origin-bottom before:scale-y-0 before:bg-c before:[transition:scale_0.5s_var(--ease-out)] hover:text-ink hover:before:scale-y-100 md:grid-cols-[3rem_1.4fr_1fr] md:items-baseline md:px-4"
          data-color={colorFor(i)}
        >
          <span class="mono row-span-2 pt-[0.5em] text-soft group-hover/exp:text-ink md:row-auto">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-display text-[clamp(1.6rem,4.5vw,3.5rem)] leading-[0.95] font-extrabold tracking-[-0.02em] uppercase [font-stretch:125%]">{item.company}</h3>
          <p class="text-soft group-hover/exp:text-ink md:text-right">{item.role}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Skills -->
  <section class="pt-(--space-xl)" aria-label={t('about.skills')}>
    <SkillsMarquee skills={profile.skills} />
  </section>

  <!-- Education + training as a terminal log -->
  <section class="wrap pt-(--space-xl)" aria-labelledby="edu-heading">
    <div class="section-head">
      <h2 id="edu-heading" class="section-title heading-art" data-split="words">{t('about.education')}</h2>
    </div>

    <div class="reveal overflow-hidden rounded-[10px] border border-line bg-surface">
      <div class="flex items-center gap-[6px] border-b border-line bg-surface-2 px-4 py-3" aria-hidden="true">
        <span class="size-[11px] rounded-full bg-block-red"></span>
        <span class="size-[11px] rounded-full bg-block-yellow"></span>
        <span class="size-[11px] rounded-full bg-block-lime"></span>
        <p class="ml-auto font-mono text-(length:--text-mono) tracking-[0.04em] text-soft">{t('about.logFile')}</p>
      </div>
      <div class="p-[clamp(1rem,3vw,2rem)] font-mono text-[clamp(0.8rem,1.2vw,0.95rem)] leading-[1.7]">
        <p class="mb-2 text-soft"><span class="text-accent">$</span> {t('about.cmdEdu')}</p>
        <ul class="mb-6" role="list">
          {profile.education.map((e) => (
            <li class={rowClass}>
              <span class="text-block-cyan">[{e.period}]</span>
              <span><strong class="font-medium text-fg">{e.degree}</strong> <span class="text-soft">— {e.institution}</span></span>
            </li>
          ))}
        </ul>

        <p class="mb-2 text-soft"><span class="text-accent">$</span> {t('about.cmdTraining')}</p>
        <ul class="mb-6" role="list">
          {profile.training.map((t) => (
            <li class={rowClass}>
              <span class="text-block-cyan">[{t.year}]</span>
              <span>{t.title} <span class="text-soft">— {t.platform} · {t.hours}h</span></span>
            </li>
          ))}
        </ul>
        <p class="mb-2 text-soft">
          <span class="text-accent">$</span> <span class="inline-block h-[1.1em] w-[0.6em] animate-caret bg-accent align-text-bottom" aria-hidden="true"></span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

