---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ClientGrid from '../components/ClientGrid.astro';
import Portrait from '../components/Portrait.astro';
import { getProfile } from '../data/profile';
import { getProjects, getClients, getFeaturedClients } from '../data/work';
import { getLangFromUrl, useTranslations, path } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);

const projects = await getProjects(lang);
const clients = await getClients();
const liveClients = clients.filter((c) => c.status !== 'archived');
const previewClients = await getFeaturedClients();

const stats = [
  { value: projects.length, label: t('home.stat.projects') },
  { value: clients.length, label: t('home.stat.clients') },
  { value: profile.skills.length, label: t('home.stat.skills') },
];
---
<BaseLayout description={profile.bio}>
  <Hero name={profile.name} tagline={profile.tagline} location={profile.location} />

  <!-- Manifesto -->
  <section class="wrap py-(--space-xl)" aria-labelledby="manifesto-heading">
    <h2 id="manifesto-heading" class="eyebrow">{t('home.manifesto')}</h2>
    <div class="mt-(--space-md) grid grid-cols-1 items-center gap-(--space-lg) lg:grid-cols-[1.6fr_1fr]">
      <p class="max-w-[22ch] font-display text-lead leading-[1.08] font-medium tracking-[-0.03em] md:max-w-[26ch]" data-scrub-words>{t('home.manifestoText')}</p>
      <a href={path('about', lang)} class="reveal block max-w-[340px] lg:w-full lg:max-w-[420px] lg:justify-self-end" data-cursor={t('nav.about')} aria-label={t('nav.about')}>
        <div data-parallax="0.12"><Portrait /></div>
      </a>
    </div>
    <dl class="mt-(--space-lg) grid grid-cols-1 gap-(--tile-gap) md:grid-cols-3 md:gap-(--space-md)">
      {stats.map((s) => (
        <div class="reveal flex items-end justify-between gap-4 border-t border-line py-(--space-sm) md:flex-col md:items-start">
          <dt class="mono text-soft">{s.label}</dt>
          <dd class="font-art text-[clamp(3.5rem,9vw,7rem)] leading-[0.8] font-normal tracking-[-0.01em]" data-count={s.value}>{String(s.value).padStart(2, '0')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Work -->
  <section id="trabajo" class="wrap pb-(--space-xl)" aria-labelledby="work-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t('home.work')}</p>
        <h2 id="work-heading" class="section-title heading-art" data-split="words">{t('work.title')}</h2>
      </div>
      <a href={path('projects', lang)} class="btn" data-magnetic>{t('common.seeAll')}</a>
    </div>
    <WorkGrid featured />
  </section>

  <!-- Skills -->
  <section class="border-y border-line py-(--space-lg)" aria-labelledby="skills-heading">
    <div class="wrap">
      <h2 id="skills-heading" class="eyebrow mb-(--space-md)">{t('home.stack')}</h2>
    </div>
    <SkillsMarquee skills={profile.skills} />
  </section>

  <!-- Clients -->
  <section class="wrap py-(--space-xl)" aria-labelledby="clients-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t('home.clients')}</p>
        <h2 id="clients-heading" class="section-title heading-art">
          <span data-count={liveClients.length}>{liveClients.length}</span> {t('home.liveSites')} <span class="text-outline">{t('home.liveSitesOutline')}</span>
        </h2>
      </div>
      <a href={path('clients', lang)} class="btn" data-magnetic>{t('common.seeAll')}</a>
    </div>
    <ClientGrid clients={previewClients} filters={false} />
  </section>
</BaseLayout>

