---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientGrid from '../components/ClientGrid.astro';
import { getClients } from '../data/work';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));
const clients = await getClients();
---
<BaseLayout
  title={`${t('clients.title')} — Wilson Yépez @Pryw00`}
  description={t('clients.lead')}
>
  <section class="wrap pt-[calc(var(--header-h)+var(--space-lg))] pb-(--space-xl)" aria-labelledby="clients-heading">
    <header class="mb-(--space-lg)">
      <p class="eyebrow">{t('clients.eyebrow')}</p>
      <h1 id="clients-heading" class="heading-art mt-(--space-xs) flex items-start gap-[0.1em] text-(length:--text-giant)">
        <span data-split>{t('clients.title')}</span>
        <sup class="static mt-[0.8em] rounded-full align-super leading-[0.88] bg-accent px-[0.6rem] py-[0.3rem] font-mono text-[clamp(0.75rem,1.4vw,1rem)] tracking-normal text-bg uppercase" data-count={clients.length}>{clients.length}</sup>
      </h1>
      <p class="mt-(--space-md) max-w-[48ch] text-soft">{t('clients.lead')}</p>
    </header>

    <ClientGrid clients={clients} />
  </section>
</BaseLayout>

<script>
  import '../scripts/filters';
</script>

