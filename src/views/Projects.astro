---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { getProjects, getClients } from '../data/work';
import { getLangFromUrl, useTranslations, path } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const clients = await getClients();

const kinds = [...new Set(projects.map((p) => p.data.kind))];
const filters = [
  ...kinds.map((k) => ({ value: k, label: t(`kind.${k}`), count: projects.filter((p) => p.data.kind === k).length })),
  { value: 'client', label: t('kind.client'), count: clients.length },
];
const archivedCount =
  projects.filter((p) => p.data.status === 'archived').length + clients.filter((c) => c.status === 'archived').length;
---
<BaseLayout
  title={`${t('work.title')} — Wilson Yépez @Pryw00`}
  description={t('work.lead')}
>
  <div class="wrap grid grid-cols-1 gap-(--space-md) pt-[calc(var(--header-h)+var(--space-md))] pb-(--space-xl) *:min-w-0 lg:grid-cols-[minmax(260px,1fr)_3fr]">
    <aside>
      <div class="lg:sticky lg:top-[calc(var(--header-h)+var(--space-sm))]">
        <p class="eyebrow">{t('work.eyebrow')}</p>
        <h1 class="heading-art mt-(--space-xs) mb-(--space-sm) text-(length:--text-h1) lg:text-[clamp(2rem,3.5vw,4rem)]" data-split>{t('work.title')}</h1>
        <p class="mb-(--space-md) max-w-[36ch] text-soft">{t('work.lead')}</p>
        <div
          class="chips rail mb-(--space-sm) lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0"
          data-filters="projects"
          data-filter-key="kind"
          role="group"
          aria-label={t('work.filter')}
        >
          <button class="chip" data-filter="*" aria-pressed="true">{t('work.all')} · {projects.length + clients.length}</button>
          {filters.map((f) => (
            <button class="chip" data-filter={f.value} aria-pressed="false">{f.label} · {f.count}</button>
          ))}
          {archivedCount > 0 && (
            <button class="chip" data-filter="archived" data-filter-key="status" aria-pressed="false">
              {t('status.filter')} · {archivedCount}
            </button>
          )}
        </div>
        <a href={path('clients', lang)} class="mono inline-flex min-h-11 items-center text-soft transition-colors duration-180 ease-out hover:text-accent">{t('work.clientsLink')}</a>
      </div>
    </aside>

    <div data-filter-scope="projects">
      <WorkGrid withClients />
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/filters';
</script>

